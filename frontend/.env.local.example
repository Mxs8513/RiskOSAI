# Base URL of the RiskOS backend API.
# Local dev: http://localhost:8000
# Production: your Render service URL, e.g. https://riskosai-api.onrender.com
#
# If the backend is cold-starting or unreachable, the frontend automatically
# falls back to seeded demo data — no extra config required.
NEXT_PUBLIC_API_URL=http://localhost:8000
