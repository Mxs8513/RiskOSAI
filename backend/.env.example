# RiskOS AI backend configuration
# Copy to .env — every value has a working default, so this file is optional.

# ---------------------------------------------------------------- database
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./riskos.db
# PostgreSQL (production-style):
# DATABASE_URL=postgresql+psycopg2://riskos:riskos@localhost:5432/riskos

# ---------------------------------------------------------------- auth
JWT_SECRET=change-me-in-real-deployments
JWT_EXPIRE_MINUTES=480

# ---------------------------------------------------------------- AI provider
# RiskOS has two AI providers:
#   - anthropic : calls the Claude API for evidence packets, intelligence
#                 summaries, and developer test scenarios.
#   - mock      : deterministic templates built from the same structured
#                 risk-engine signals — the full workflow runs offline.
#
# Which one runs is decided like this:
#   ANTHROPIC_API_KEY unset/empty  -> mock (default; no key, no network calls)
#   ANTHROPIC_API_KEY set          -> anthropic
#   MOCK_AI=true                   -> mock, even if a key is set (useful for
#                                     tests/CI and for demoing without spend)
#
# The active provider is shown in the UI header ("AI provider: mock") and
# recorded on every AI report (generated_by) and audit event (meta.provider).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# MOCK_AI=true

# ---------------------------------------------------------------- outbound SMS (Phase 2)
# Optional. When unset (default), verification SMS events are still recorded
# (status "queued") but nothing is sent — the demo works fully offline.
#
# Safety guard: when SMS_ENABLED=true, messages are sent ONLY to
# DEMO_CUSTOMER_PHONE. Generated customer numbers are never contacted, and
# only masked numbers are stored or returned by the API.
# Messages are strict templates — never LLM-generated.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Your own phone, E.164 format, e.g. +15551234567:
DEMO_CUSTOMER_PHONE=

# ---------------------------------------------------------------- CORS
# Comma-separated list of allowed frontend origins. Defaults cover local dev
# (ports 3000/3001). For a deployed frontend, add its exact origin here —
# e.g. CORS_ORIGINS=http://localhost:3000,https://riskos.example.com
# Never use "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
